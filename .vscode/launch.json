{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SchoolManagement.Api",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/SchoolManagement.Api/bin/Debug/net8.0/SchoolManagement.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SchoolManagement.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7195;http://localhost:5128"
            }
        }
    ]
}
